#=====================================================
# tdc_zedboard.xdc  —  ZedBoard (XC7Z020-CLG484) 제약
# Generated by Claude Code, 2026-09-02
#
#  [이 파일이 따로 있는 이유]
#  Zybo(XC7Z010) 용 RTL/tdc.xdc 를 건드리지 않고 ZedBoard 를 지원하기 위함이다.
#  최상위가 tdc_zedboard_top(래퍼)이고 그 안에 tdc_test_top 이 u_core 로 들어간다.
#
#  [Zybo XDC 와 다른 점 — 이 세 가지뿐이다]
#    1) 핀 배치 전부 (아래 §1)
#    2) 클럭 포트 이름 clk_125 -> clk_100
#    3) 히트 입력이 단일선 -> LVDS 차동쌍 (IBUFDS 는 래퍼 안에 있다)
#    4) ★ 2026-09-03 추가 — 캐리체인이 80단(320탭)이 아니라 112단(448탭)이다.
#
#  [★ 2026-09-03 수정 : 80단 -> 112단 (320탭 -> 448탭)]
#    무엇이 문제였나 : 2026-09-03 Mode 2 측정에서 ZedBoard 는 320탭이 5 ns 안에
#      전부 채워졌다. 즉 지연선이 클럭 한 주기보다 짧다. 끝단에 빈 칸이 안 생기면
#      (a) 유효탭 상한을 히스토그램에서 읽어낼 방법이 없고,
#      (b) 최악의 경우 320탭을 다 지나고도 시간이 남아 sum_fine=320 이 되는데
#          tdc_calib_rom 이 320칸이라 주소 범위 밖을 읽는 사각지대가 생긴다.
#      448탭이면 세 보드 전부 뒤쪽 20 % 이상이 0 으로 비므로 상한이 눈에 보인다.
#    왜 448 인가 : sum_fine/ts_fine_idx 가 [8:0](<=511), 히스토그램 512칸,
#      stg3_group 이 [7:0]. 448 = 4x7x16 이라 선언 폭을 하나도 안 바꿔도 된다.
#    이 §2 블록(2800줄)은 손으로 쓴 것이 아니라 python/gen_chain_xdc.py 로 생성한다.
#      단수를 바꾸려면  python gen_chain_xdc.py --stages <N>  을 다시 돌릴 것.
#      (80단으로 돌리면 2026-09-02 원본과 바이트 단위로 동일함을 확인했다)
#    RTL 쪽도 같이 바뀌어야 한다 : tdc_zedboard_top.v 가 CARRY4_STAGES=112 를 넘기고,
#      tdc_test_top.v 의 리드아웃 스캔이 NUM_TAPS-1(=447) 까지 돈다.
#    ※ tdc_calib_rom IP 를 448칸으로 재생성할 것. 320칸 그대로면 탭 320 이상이
#      전부 범위 밖 주소가 된다.
#
#  [LOC 좌표를 그대로 쓸 수 있는 근거 — 2026-09-02 / 09-03 실측]
#    link_design -part xc7z020clg484-1 로 조회한 결과
#      SLICE_X42 : Y0~Y149 연속, SLICEM   (캐리체인 + u_ff_*)
#      SLICE_X43 : Y0~Y149 연속, SLICEL   (taps_sampled_d1_reg)
#    112단은 Y0~Y111 만 쓰므로 38행 여유가 남는다 (최대 150단까지 가능).
#    Zybo(XC7Z010)와 열 타입·연속성이 같아 좌표를 옮길 필요가 없다.
#    ※ 그래도 첫 빌드 후에는 히스토그램을 떠서 탭 폭 분포를 확인할 것.
#      칩이 다르므로 탭 폭 자체는 Zybo 와 다르게 나오는 것이 정상이다.
#
#  [RTL 밖에서 해야 할 것]
#    (a) clk_wiz_0 IP 재생성 : 입력 100 MHz, VCO 1000 MHz(M=10,D=1),
#        CLKOUT0/CLKOUT1 = 200 MHz. VCO 를 1000 MHz 로 둬야
#        phase_shifter.v 의 PHASE_STEP = 1000/56 = 17.857 ps 가 성립한다.
#    (b) 점퍼 J18 을 2.5V 로 (기본 1.8V). 뱅크 34/35 VCCO 가 2.5V 여야
#        LVDS_25 수신과 DIFF_TERM(내부 100옴)이 규격 안에서 동작한다.
#        ★ 이걸 안 하면 버튼(뱅크34)과 LA27(뱅크35) IOSTANDARD 가 전부 어긋난다.
#=====================================================

#=====================================================
#1. ZEDBOARD PIN & I/O STANDARD
#=====================================================

# --- PL 클럭 : 온보드 100 MHz 발진기(IC17), 뱅크 13 (3.3V 고정) ---
set_property PACKAGE_PIN Y9 [get_ports clk_100]
set_property IOSTANDARD LVCMOS33 [get_ports clk_100]
create_clock -period 10.000 -name clk_100_pin [get_ports clk_100]

# --- 버튼 : 뱅크 34 (VADJ = 2.5V) ---
#   rst_n 은 이름과 달리 MMCM 의 active-high reset 으로 들어간다(코어 설계 그대로).
set_property PACKAGE_PIN P16 [get_ports rst_n]
set_property IOSTANDARD LVCMOS25 [get_ports rst_n]

set_property PACKAGE_PIN T18 [get_ports btn_shift]
set_property IOSTANDARD LVCMOS25 [get_ports btn_shift]

# --- LED LD0~LD3 : 뱅크 33 (3.3V 고정) ---
set_property PACKAGE_PIN T22 [get_ports {led[0]}]
set_property PACKAGE_PIN T21 [get_ports {led[1]}]
set_property PACKAGE_PIN U22 [get_ports {led[2]}]
set_property PACKAGE_PIN U21 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[*]}]

# =====================================================================
# TLV3605 LVDS 히트 입력 — FMC LPC LA27_P/N, 뱅크 35 (VADJ = 2.5V)
# =====================================================================
#   DIFF_TERM 으로 FPGA 내부 100옴 차동 종단을 켠다. 종단이 없으면 반사로
#   에지가 무너지고, 그건 캐리체인 진입 slew 저하 -> 진입 트랜지언트 악화로
#   직결된다. (tdc_test_top.v 의 led[2] 사례 : hit 네트에 부하가 붙자
#   CARRY4 초입 3단이 정상값의 1.16~1.89배로 늘어났다)
set_property PACKAGE_PIN E21 [get_ports hit_lvds_p]
set_property PACKAGE_PIN D21 [get_ports hit_lvds_n]
set_property IOSTANDARD LVDS_25 [get_ports hit_lvds_p]
set_property IOSTANDARD LVDS_25 [get_ports hit_lvds_n]
set_property DIFF_TERM TRUE [get_ports hit_lvds_p]
set_property DIFF_TERM TRUE [get_ports hit_lvds_n]

# 히트는 클럭과 완전히 비동기다(그게 측정 대상이다). 타이밍 분석에서 제외한다.
set_false_path -from [get_ports hit_lvds_p]

# 클럭 MUX로 인한 Inter-Clock False Path 설정 (Logically Exclusive)
#   래퍼가 생겨 계층이 한 단 깊어졌으므로 와일드카드로 찾는다.
set_clock_groups -logically_exclusive \
    -group [get_clocks -of_objects [get_pins -hierarchical -filter {NAME =~ *mmcm_adv_inst/CLKOUT0}]] \
    -group [get_clocks -of_objects [get_pins -hierarchical -filter {NAME =~ *mmcm_adv_inst/CLKOUT1}]]



#=====================================================
#2. RING OSCILLATOR (조합 루프 허용)
#=====================================================
set_property ALLOW_COMBINATORIAL_LOOPS true [get_nets -hierarchical -filter {NAME =~ *RO_LOOP* || NAME =~ *ro_chain*}]

#=====================================================
#3. TDC CARRY4 & SAMPLING REGISTER 최적화
#=====================================================
# [수정] REF_NAME(FDC 등)이 Vivado 맘대로 변신해도 찾을 수 있게 고유 이름(NAME)으로만 검색
set_property DONT_TOUCH true [get_cells -hierarchical -filter {NAME =~ *u_tdc*u_carry4*}]
set_property DONT_TOUCH true [get_cells -hierarchical -filter {NAME =~ *u_tdc*CARRY_CHAIN*u_ff_*}]
set_property ASYNC_REG true [get_cells -hierarchical -filter {NAME =~ *u_tdc*CARRY_CHAIN*u_ff_*}]

set_property DONT_TOUCH true [get_cells -hierarchical -filter {NAME =~ *taps_sampled_d1_reg*}]
set_property ASYNC_REG true [get_cells -hierarchical -filter {NAME =~ *taps_sampled_d1_reg*}]

# ==========================================================================
# ★ 2026-08-22 삭제 — 아래 set_max_delay 한 줄을 제거했다.
#
#   지웠던 줄:
#     set_max_delay -datapath_only \
#       -from [get_pins -hierarchical -filter {NAME =~ *u_tdc*u_carry4/O*}] \
#       -to   [get_pins -hierarchical -filter {NAME =~ *u_tdc*CARRY_CHAIN*u_ff_*/D}] 0.150
#
#   [왜 지웠나]
#   (1) 아무 효과가 없다. 바로 아래 set_false_path -through *carry_o* 가 같은 경로를
#       덮는데, false_path 가 max_delay 를 이긴다. 2026-08-13 실측으로 확인했다 —
#       이 경로들은 datapath 0.000 ns, WNS 0.000 으로 타이밍 분석에서 제외돼 있었다.
#   (2) CO 빌드와는 아예 무관하다. *u_carry4/O* 는 O(XOR) 출력을 겨냥하는데
#       tdc_fmcw_core_co 는 탭을 carry_co(캐리 출력)에서 뽑는다.
#   (3) Critical Warning 을 320개(80단 x O[0..3]) 쏟아낸다.
#       [Constraints 18-515] set_max_delay: Path segmentation by forcing
#         'u_tdc/CARRY_CHAIN[k].STAGE_*.u_carry4/O[j]' to be timing startpoint.
#       O[j] 는 조합 출력 핀이라 정상적인 타이밍 시작점이 아니다. -from 으로 지정하면
#       Vivado 가 그 지점에서 경로를 잘라(segmentation) 상류(캐리 전파)의 도착 시각을
#       버린다. 경고가 320개 쌓이면 진짜 경고가 묻힌다.
#
#   [영향] 기능·배치·배선 모두 변화 없을 것으로 예상한다. 다만 이번 빌드는 코어를
#   O -> CO 로 바꾼 새 빌드이므로 어차피 이전 빌드와 P&R 이 다르다. 탭 폭은
#   CARRY4·FF 이 LOC/BEL 로 고정돼 실리콘이 정하므로 바뀌지 않아야 한다 —
#   빌드 후 히스토그램을 python/co_histo_back.csv(집 보드 8/13) 와 대조해 r > 0.99 를
#   확인할 것. (Markdown/2026-08-22_home_board_campaign.md §3-4)
# ==========================================================================

set_false_path -through [get_nets -hierarchical -filter {NAME =~ *carry_o*}]
set_false_path -through [get_nets -hierarchical -filter {NAME =~ *carry_co*}]

#=====================================================
#4. PBLOCK 설정 (파이프라인 격리)
#=====================================================
create_pblock pblock_pipeline
# [수정] 옛날 변수명(snapshot) 지우고, 최신 5-Stage 파이프라인 변수명들로 교체
add_cells_to_pblock [get_pblocks pblock_pipeline] [get_cells -hierarchical -filter {NAME =~ *stg* || NAME =~ *mul* || NAME =~ *_d2_reg* || NAME =~ *_d3_reg* || NAME =~ *_d4_reg* || NAME =~ *_d5_reg*}]
resize_pblock [get_pblocks pblock_pipeline] -add {SLICE_X42Y0:SLICE_X59Y140}

#=====================================================
#5. 기타 제약 및 클럭 (ILA 포함)
#=====================================================
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets -of_objects [get_ports clk_100]]

# 링 오실레이터 클럭 정의
set_disable_timing -from I -to O [get_cells -hierarchical -filter {NAME =~ *u_bufg_ro}]
create_clock -period 5.000 -name RO_CLK [get_pins -hierarchical -filter {NAME =~ *u_bufg_ro/O}]
set_clock_groups -asynchronous -group [get_clocks RO_CLK]

# [수정] 합성 초기에 dbg_hub를 못 찾아서 에러나는 현상을 방어 (catch 구문)

set_property ASYNC_REG false [get_cells -hierarchical -filter {NAME =~ *u_ff_*}]
set_property ASYNC_REG false [get_cells -hierarchical -filter {NAME =~ *taps_sampled_d1_reg*}]
set_property LOC SLICE_X42Y0 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0].STAGE*u_carry4*}]
set_property BEL AFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_0*}]
set_property BEL AFF [get_cells {u_tdc/CARRY_CHAIN[0].u_ff_0}]
set_property LOC SLICE_X42Y0 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_0*}]
set_property BEL BFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_1*}]
set_property BEL BFF [get_cells {u_tdc/CARRY_CHAIN[0].u_ff_1}]
set_property LOC SLICE_X42Y0 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_1*}]
set_property BEL CFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_2*}]
set_property BEL CFF [get_cells {u_tdc/CARRY_CHAIN[0].u_ff_2}]
set_property LOC SLICE_X42Y0 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_2*}]
set_property BEL DFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_3*}]
set_property BEL DFF [get_cells {u_tdc/CARRY_CHAIN[0].u_ff_3}]
set_property LOC SLICE_X42Y0 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[0]*u_ff_3*}]
set_property BEL AFF [get_cells -hierarchical {*taps_sampled_d1_reg[0]}]
set_property BEL AFF [get_cells {u_tdc/taps_sampled_d1_reg[0]}]
set_property LOC SLICE_X43Y0 [get_cells -hierarchical {*taps_sampled_d1_reg[0]}]
set_property BEL BFF [get_cells -hierarchical {*taps_sampled_d1_reg[1]}]
set_property BEL BFF [get_cells {u_tdc/taps_sampled_d1_reg[1]}]
set_property LOC SLICE_X43Y0 [get_cells -hierarchical {*taps_sampled_d1_reg[1]}]
set_property BEL CFF [get_cells -hierarchical {*taps_sampled_d1_reg[2]}]
set_property BEL CFF [get_cells {u_tdc/taps_sampled_d1_reg[2]}]
set_property LOC SLICE_X43Y0 [get_cells -hierarchical {*taps_sampled_d1_reg[2]}]
set_property BEL DFF [get_cells -hierarchical {*taps_sampled_d1_reg[3]}]
set_property BEL DFF [get_cells {u_tdc/taps_sampled_d1_reg[3]}]
set_property LOC SLICE_X43Y0 [get_cells -hierarchical {*taps_sampled_d1_reg[3]}]
set_property LOC SLICE_X42Y1 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1].STAGE*u_carry4*}]
set_property BEL AFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_0*}]
set_property BEL AFF [get_cells {u_tdc/CARRY_CHAIN[1].u_ff_0}]
set_property LOC SLICE_X42Y1 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_0*}]
set_property BEL BFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_1*}]
set_property BEL BFF [get_cells {u_tdc/CARRY_CHAIN[1].u_ff_1}]
set_property LOC SLICE_X42Y1 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_1*}]
set_property BEL CFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_2*}]
set_property BEL CFF [get_cells {u_tdc/CARRY_CHAIN[1].u_ff_2}]
set_property LOC SLICE_X42Y1 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_2*}]
set_property BEL DFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_3*}]
set_property BEL DFF [get_cells {u_tdc/CARRY_CHAIN[1].u_ff_3}]
set_property LOC SLICE_X42Y1 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[1]*u_ff_3*}]
set_property BEL AFF [get_cells -hierarchical {*taps_sampled_d1_reg[4]}]
set_property BEL AFF [get_cells {u_tdc/taps_sampled_d1_reg[4]}]
set_property LOC SLICE_X43Y1 [get_cells -hierarchical {*taps_sampled_d1_reg[4]}]
set_property BEL BFF [get_cells -hierarchical {*taps_sampled_d1_reg[5]}]
set_property BEL BFF [get_cells {u_tdc/taps_sampled_d1_reg[5]}]
set_property LOC SLICE_X43Y1 [get_cells -hierarchical {*taps_sampled_d1_reg[5]}]
set_property BEL CFF [get_cells -hierarchical {*taps_sampled_d1_reg[6]}]
set_property BEL CFF [get_cells {u_tdc/taps_sampled_d1_reg[6]}]
set_property LOC SLICE_X43Y1 [get_cells -hierarchical {*taps_sampled_d1_reg[6]}]
set_property BEL DFF [get_cells -hierarchical {*taps_sampled_d1_reg[7]}]
set_property BEL DFF [get_cells {u_tdc/taps_sampled_d1_reg[7]}]
set_property LOC SLICE_X43Y1 [get_cells -hierarchical {*taps_sampled_d1_reg[7]}]
set_property LOC SLICE_X42Y2 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2].STAGE*u_carry4*}]
set_property BEL AFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_0*}]
set_property BEL AFF [get_cells {u_tdc/CARRY_CHAIN[2].u_ff_0}]
set_property LOC SLICE_X42Y2 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_0*}]
set_property BEL BFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_1*}]
set_property BEL BFF [get_cells {u_tdc/CARRY_CHAIN[2].u_ff_1}]
set_property LOC SLICE_X42Y2 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_1*}]
set_property BEL CFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_2*}]
set_property BEL CFF [get_cells {u_tdc/CARRY_CHAIN[2].u_ff_2}]
set_property LOC SLICE_X42Y2 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_2*}]
set_property BEL DFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_3*}]
set_property BEL DFF [get_cells {u_tdc/CARRY_CHAIN[2].u_ff_3}]
set_property LOC SLICE_X42Y2 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[2]*u_ff_3*}]
set_property BEL AFF [get_cells -hierarchical {*taps_sampled_d1_reg[8]}]
set_property BEL AFF [get_cells {u_tdc/taps_sampled_d1_reg[8]}]
set_property LOC SLICE_X43Y2 [get_cells -hierarchical {*taps_sampled_d1_reg[8]}]
set_property BEL BFF [get_cells -hierarchical {*taps_sampled_d1_reg[9]}]
set_property BEL BFF [get_cells {u_tdc/taps_sampled_d1_reg[9]}]
set_property LOC SLICE_X43Y2 [get_cells -hierarchical {*taps_sampled_d1_reg[9]}]
set_property BEL CFF [get_cells -hierarchical {*taps_sampled_d1_reg[10]}]
set_property BEL CFF [get_cells {u_tdc/taps_sampled_d1_reg[10]}]
set_property LOC SLICE_X43Y2 [get_cells -hierarchical {*taps_sampled_d1_reg[10]}]
set_property BEL DFF [get_cells -hierarchical {*taps_sampled_d1_reg[11]}]
set_property BEL DFF [get_cells {u_tdc/taps_sampled_d1_reg[11]}]
set_property LOC SLICE_X43Y2 [get_cells -hierarchical {*taps_sampled_d1_reg[11]}]
set_property LOC SLICE_X42Y3 [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[3].STAGE*u_carry4*}]
set_property BEL AFF [get_cells -hierarchical -filter {NAME =~ *CARRY_CHAIN[3]*u_ff_0*}]
set_property BEL AFF [get_cells {u_tdc/CARRY_CHAIN[3].u_ff_0}]
